# Backend API Configuration
VITE_API_BASE_URL=http://127.0.0.1:8001
VITE_API_TIMEOUT=30000

# Razorpay Payment Gateway
VITE_RAZORPAY_KEY_ID=rzp_live_your_key_here

# Feature Flags
VITE_ENABLE_TRY_ON=true
VITE_ENABLE_RECOMMENDATIONS=true
VITE_ENABLE_PAYMENTS=true

# Image Upload Configuration
VITE_MAX_IMAGE_SIZE=10485760
VITE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Try-On Processing
VITE_TRYON_POLLING_INTERVAL=2000
VITE_TRYON_MAX_POLLING_TIME=300000

# Media URLs
VITE_MEDIA_BASE_URL=http://127.0.0.1:8001/media

# Environment
VITE_APP_NAME=FashionAI
VITE_ENVIRONMENT=development
