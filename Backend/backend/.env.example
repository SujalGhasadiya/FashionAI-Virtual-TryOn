# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=chromafit

# Security & JWT
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ADMIN_CREATION_SECRET=change-this-admin-bootstrap-secret

# Virtual Try-On (VTON) Settings
TRYON_MOCK_MODE=false
VTON_DEVICE=cuda
VTON_WEIGHTS_DIR=./weights
VTON_GARMENT_PHOTO_TYPE=flat-lay
VTON_NUM_TIMESTEPS=8
VTON_GUIDANCE_SCALE=2.0
VTON_SEGMENTATION_FREE=false

# SMTP Configuration for Email & OTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=FashionAI
SMTP_USE_TLS=true

# OTP Configuration
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_MAX_RESEND_PER_HOUR=10
FRONTEND_BASE_URL=http://localhost:5173

# Razorpay Configuration
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_CURRENCY=INR
RAZORPAY_CHECKOUT_NAME=FashionAI
RAZORPAY_CHECKOUT_DESCRIPTION=Virtual Try-On Service

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

